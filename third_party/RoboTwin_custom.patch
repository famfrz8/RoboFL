+def resize_intrinsics(intrinsics, src_hw, dst_hw):
+    src_h, src_w = src_hw
+    dst_h, dst_w = dst_hw
+    resized = np.array(intrinsics, dtype=np.float32).copy()
+    resized[0, 0] *= dst_w / src_w
+    resized[1, 1] *= dst_h / src_h
+    resized[0, 2] *= dst_w / src_w
+    resized[1, 2] *= dst_h / src_h
+    return resized
 
 
